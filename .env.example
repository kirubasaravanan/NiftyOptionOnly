# DhanHQ credentials — required for LIVE / PAPER mode with real data.
# Leave empty to run in NO_DATA mode (system will log NO-TRADE and exit).
# Today (holiday) the market is closed — system will detect this and stay in cash.

DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=

# Run modes: backtest | paper | live
ENGINE_RUN_MODE=paper

# Capital (INR) — used by risk engine for position sizing
ENGINE_CAPITAL=1000000

# Where to write journals / decisions
ENGINE_RUNS_DIR=/home/z/my-project/runs
