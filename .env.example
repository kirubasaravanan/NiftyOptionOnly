# DhanHQ credentials — required for LIVE / PAPER mode with real data.
# Leave empty to run in NO_DATA mode (system will log NO-TRADE and exit).
# Get these from https://dhanhq.co (Settings → API Keys)

DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=
DHAN_API_KEY=
DHAN_API_SECRET=

# Discord webhook for live trade lifecycle notifications
# Get from: Discord channel → Edit Channel → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=
DISCORD_ENABLED=true
DISCORD_MIN_LEVEL=INFO

# Run modes: backtest | paper | live
ENGINE_RUN_MODE=paper

# Capital (INR) — used by risk engine for position sizing
ENGINE_CAPITAL=1000000

# Where to write journals / decisions / alerts
ENGINE_RUNS_DIR=/home/z/my-project/runs

# Backend API port (FastAPI)
ENGINE_API_PORT=8000

# Frontend port (Next.js)
FRONTEND_PORT=3000
